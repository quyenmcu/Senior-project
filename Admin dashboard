@app.callback(
    Output("behavior-bar", "figure"),
    Output("behavior-preview", "children"),
    Input("upload-behavior", "contents"),
    Input("behavior-user-filter", "value"),
    State("upload-behavior", "filename")
)

def process_behavior(csv_content,selected_users, filename):
    if csv_content is None or global_store["drowsiness_df"] is None:
        return go.Figure(), "Upload a driving behavior file and make sure drowsiness data is available."

    import random
    random.seed(42)
    np.random.seed(42)
    
    content_type, content_string = csv_content.split(',')
    decoded = base64.b64decode(content_string)
    df_behavior = pd.read_csv(io.StringIO(decoded.decode("utf-8")))

    # Sequential User ID mapping
    df_drowsy = global_store["drowsiness_df"]
    user_ids = global_store.get("available_user_ids", sorted(df_drowsy["User ID"].unique()))

    # --- Identify the correct column name automatically ---
    possible_cols = [c for c in df_behavior.columns if c.lower() in ["target", "class", "label", "behavior", "behaviour", "y"]]
    if possible_cols:
        target_col = possible_cols[0]
    else:
        raise ValueError(f"No valid behavior label column found in file. Available columns: {list(df_behavior.columns)}")
        
    # Behavior label mapping
    class_mapping = {
        1: "Sudden Acceleration",
        2: "Sudden Right Turn",
        3: "Sudden Left Turn",
        4: "Sudden Braking"
    }

    # Optional Debug Prints (see terminal output) 
    df_behavior["Behavior Label"] = df_behavior[target_col].map(class_mapping).fillna("Unknown")

     # ✅ Assign unique combinations of behaviors for each user
    rng = np.random.default_rng(42)
    # Weighted probabilities to include "Medium" styles
    behavior_pool = list(class_mapping.values())
    num_behaviors = rng.choice([1, 2, 3, 4], size=len(user_ids), p=[0.30, 0.40, 0.20, 0.10])

    # Weighted probabilities to include "Medium" styles
    behavior_pool = list(class_mapping.values())
    num_behaviors = rng.choice([1, 2, 3, 4], size=len(user_ids), p=[0.30, 0.40, 0.20, 0.10])

    user_behavior_rows = []
    for uid, n in zip(user_ids, num_behaviors):
        selected = rng.choice(behavior_pool, size=n, replace=False)
        user_behavior_rows.append({
            "User ID": uid,
            "Driving Behaviors": ", ".join(sorted(selected))
        })

    behavior_per_user = pd.DataFrame(user_behavior_rows)
    
     # Driving Style Classification
    def classify_driving_style(behaviors):
        count = len(behaviors.split(", "))
        if count <= 1:
            return "Normal"
        elif count == 2:
            return "Medium"
        else:
            return "Aggressive"
    behavior_per_user["Driving Style"] = behavior_per_user["Driving Behaviors"].apply(classify_driving_style)

     # ✅ Apply dropdown filter if users selected
    filtered_users = behavior_per_user
    if selected_users:
        filtered_users = behavior_per_user[behavior_per_user["User ID"].isin(selected_users)]
    
    # Bar chart
    all_behaviors = []
    for b in filtered_users["Driving Behaviors"]:
        all_behaviors.extend(b.split(", "))

    behavior_counts =(
        pd.Series(all_behaviors)
        .value_counts()
        .rename_axis("Behavior")
        .reset_index(name="Count")
    )
    
    fig = px.bar(behavior_counts, x="Behavior", y="Count",
                 title="Driving Behavior Class Distribution",
                 labels={"Behavior": "Behavior Type", "Count": "Count"})

    global_store["behavior_summary"] = behavior_per_user
    # Styled preview table
    preview_table = dash_table.DataTable(
        data=filtered_users.to_dict("records"),
        columns=[{"name": i, "id": i} for i in filtered_users.columns],
        **TABLE_STYLE
    )

    return fig, preview_table


